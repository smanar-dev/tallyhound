# Copy to .env for local development. Never commit .env. In staging and production these live in the host's secret store.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/th_dev
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Development and first staging only. Production keeps the master key in the cloud key service (T-102).
TH_MASTER_KEY=
# Any long random string. Signs the emailed sign-in links.
TH_LINK_SECRET=
APP_URL=http://localhost:3000
PORT=3000
# The host clients see in their links, if it is not the same as APP_URL's (for example go.tallyhound.com). No https://, no path.
LINK_HOST=
# Leave these empty until the accounts exist (T-136). Without them: sign-in links print to the terminal (development only),
# texts and emails are recorded as failed with "not connected yet", and the engine uses rules and standard wording.
POSTMARK_TOKEN=
TH_SIGNIN_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Tallyhound's own number for texting staff who ask for it (never a firm's client number). Leave empty to keep barks in the app and by email.
TH_SYSTEM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# The name and password in the webhook address you give Postmark: https://postmark:<password>@<host>/hooks/postmark/inbound
POSTMARK_HOOK_USER=postmark
POSTMARK_HOOK_PASSWORD=
ANTHROPIC_API_KEY=
# Most the model may cost one firm in one day, in dollars, by our own estimate. Past it that firm gets rules and standard wording until tomorrow.
TH_MODEL_DAILY_CAP_USD=10
# A ClamAV daemon to scan every arriving file. Without it files are not scanned (they are still never executed, only read as images).
CLAMAV_HOST=
CLAMAV_PORT=3310
# Files. Leave S3_BUCKET empty for local disk (development only). Production needs a private bucket with versioning OFF.
# Any S3-compatible store works; set S3_ENDPOINT for one that is not Amazon's. Credentials come from AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
# Everything below is optional. Leave a line empty and that feature is simply not shown. docs/DEPLOY.md says what each needs.
# Where the developer is emailed when something is going wrong.
TH_ALERT_EMAIL=
# A firm's own storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Card billing. One price id per plan on sale; the _B ones are the second price list for firms that sign themselves up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRACTICE=
STRIPE_PRICE_FIRM=
STRIPE_PRICE_LARGE=
# Firms signing themselves up at /signup. Off unless this is "on".
TH_SIGNUP=
TH_INBOX_DOMAIN=docs.tallyhound.com
TH_PRICE_TEST=
# Email from a firm's own domain: Postmark's ACCOUNT token (not the server token above).
POSTMARK_ACCOUNT_TOKEN=
# Recorded reminder calls. Leave off until counsel has approved them.
TH_VOICE=
# The master key in AWS KMS instead of TH_MASTER_KEY (production).
TH_KMS_KEY_ID=
TH_KMS_REGION=
