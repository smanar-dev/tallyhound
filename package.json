{
  "name": "tallyhound",
  "private": true,
  "version": "0.7.0",
  "description": "Tallyhound: client tax-document collection for accounting firms",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js apps/server/test/*.test.ts",
    "test:kit": "node --test test/*.test.js",
    "typecheck": "tsc -p . && tsc -p apps/web",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "fuzz": "node tools/fuzz.js 200 600",
    "scale": "node tools/scale.js",
    "start": "node apps/server/src/main.ts",
    "admin": "node apps/server/src/admin.ts",
    "build": "vite build -c apps/web/vite.config.ts",
    "dev:web": "vite -c apps/web/vite.config.ts",
    "test:e2e": "node --test apps/web/e2e/*.test.ts",
    "local:setup": "node tools/local-setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg-mem": "^3.0.5",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@aws-sdk/client-kms": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "heic-convert": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sharp": "^0.35.5",
    "unpdf": "^1.9.1"
  }
}
